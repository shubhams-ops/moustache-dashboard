  const t=await r.text();if(/<html/i.test(t.slice(0,200)))throw new Error("Not shared");
  return rowsToData(parseCSV(t.trim()));
}
function viaJsonp(){return new Promise((res,rej)=>{
  const cb="__cg"+Date.now();const s=document.createElement("script");
  const to=setTimeout(()=>{cleanup();rej(new Error("timeout"))},12000);
  function cleanup(){clearTimeout(to);delete window[cb];s.remove()}
  window[cb]=resp=>{cleanup();try{
    if(resp.status!=="ok")throw new Error("gviz "+resp.status);
    const T=resp.table;const head=T.cols.map(c=>c.label||"");
    const rows=[head].concat(T.rows.map(r=>r.c.map(c=>c?(c.v!=null?c.v:""):"")));
    res(rowsToData(rows))}catch(e){rej(e)}};
  s.onerror=()=>{cleanup();rej(new Error("blocked"))};
  s.src=`https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json;responseHandler:${cb}&headers=1&sheet=${encodeURIComponent(SHEET_TAB)}&_=${Date.now()}`;
  document.head.appendChild(s)})}
