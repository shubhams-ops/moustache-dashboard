    <div class="sfoot">Live from the Coal &amp; Gas Google Sheet · refreshes every 5 min</div>
  </aside>

  <main>
    <div class="top">
      <div>
        <div class="eyebrow">☘️ Personal Management System · Coal &amp; Gas</div>
        <h1 id="title">Coal &amp; Gas</h1>
        <div class="sub" id="subt">FY 2026–27 · gas cylinders, coal + wood, and what they cost</div>
      </div>
      <div class="controls">
        <span class="chip" id="chip"><span class="dot"></span><span id="chipT">Connecting…</span></span>
        <select class="sel" id="propSel" aria-label="Property"></select>
