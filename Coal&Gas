  if(m.includes("kg"))return "ck";
  if(m.includes("coal")||m.includes("wood"))return "ca";return null}
function rowsToData(rows){
  const head=rows[0].map(String);
  const mIdx=[],months=[];
  head.forEach((h,i)=>{const k=h.trim().slice(0,3);const j=MONTHS_STD.findIndex(m=>m.toLowerCase()==k.toLowerCase());if(j>=0&&i>=2){mIdx.push(i);months.push(MONTHS_STD[j])}});
  if(!months.length)throw new Error("No month columns found");
  const d={};let cur="";
  for(const r of rows.slice(1)){
    if(r[0]&&String(r[0]).trim())cur=String(r[0]).trim();
    const k=keyOf(r[1]);if(!cur||!k)continue;
    (d[cur]=d[cur]||{gc:[],ga:[],ck:[],ca:[]})[k]=mIdx.map(i=>toNum(r[i]));
  }
  for(const p in d)for(const k of["gc","ga","ck","ca"])if(!d[p][k].length)d[p][k]=months.map(()=>0);
  if(!Object.keys(d).length)throw new Error("Empty sheet");
  return {data:d,months};
}
