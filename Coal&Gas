/* ===================== TABLE ===================== */
function table(){
  const d=D(),n=S.last+1,si=selI();
  let h=`<thead><tr><th>Month</th><th class="gasH">Gas cylinders</th><th class="gasH">Gas amount</th><th class="gasH">₹ / cylinder</th><th class="coalH">Coal + wood kg</th><th class="coalH">Coal + wood amount</th><th class="coalH">₹ / kg</th><th>Total fuel</th><th class="userH">Restaurant sale</th><th class="userH">Estimated expense</th><th style="min-width:78px">Fuel % of sale</th><th style="min-width:96px">Variance vs est.</th></tr></thead><tbody>`;
  const tot={gc:0,ga:0,ck:0,ca:0,sale:0,est:0,fs:0,fe:0};
  for(let i=0;i<S.months.length;i++){
    const u=U(S.prop,i),fuel=d.ga[i]+d.ca[i],future=i>S.last;
    tot.gc+=d.gc[i];tot.ga+=d.ga[i];tot.ck+=d.ck[i];tot.ca+=d.ca[i];
    if(u.sale){tot.sale+=u.sale;tot.fs+=fuel}if(u.est){tot.est+=u.est;tot.fe+=fuel}
    const pc=d.gc[i]?d.ga[i]/d.gc[i]:null,odd=pc!=null&&(pc<600||pc>5000);
    const z=v=>v?v:'<span class="mutd">0</span>';
