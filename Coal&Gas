  const pe=$("perSel");let o=`<option value="ytd">Apr – ${S.months[S.last]} (year to date)</option>`;
  for(let i=S.last;i>=0;i--)o+=`<option value="${i}">${monthLabel(i)}</option>`;
  pe.innerHTML=o;if(S.per!="ytd"&&+S.per>S.last)S.per="ytd";pe.value=S.per;
}
$("propSel").onchange=e=>{S.prop=e.target.value;saveView();render()};
$("perSel").onchange=e=>{S.per=e.target.value;saveView();render()};
$("refresh").onclick=()=>load(true);

/* ===================== RENDER ===================== */
function render(){
  const d=D(),[a,b]=range(),T=agg(d,a,b);
  const isAll=S.prop=="ALL PROPERTIES";
  const pername=S.per=="ytd"?`Apr – ${S.months[S.last]}`:monthLabel(+S.per);
  $("title").textContent=isAll?"Coal & Gas · All properties":"Coal & Gas · "+short(S.prop);
  $("subt").textContent=`FY ${FY_START_YEAR}–${String(FY_START_YEAR+1).slice(2)} · ${pername}${S.per=="ytd"&&isPartial(S.last)?" · "+S.months[S.last]+" is in progress":""}`;
  countUp($("kCyl"),T.gc,v=>N(v)+"<small>cylinders</small>");
  $("kGasAmt").textContent=RL(T.ga);
  $("kPerCyl").textContent=T.gc?R(T.ga/T.gc):"–";
  countUp($("kKg"),T.ck,v=>N(v)+"<small>kg</small>");
  $("kCoalAmt").textContent=RL(T.ca);
  $("kPerKg").textContent=T.ck?R(T.ca/T.ck):"–";
  const tot=T.ga+T.ca;$("kTot").textContent=R(tot);
  $("kTotS").innerHTML=tot?`Gas <b style="color:var(--gas)">${Math.round(T.ga/tot*100)}%</b> · Coal + wood <b style="color:var(--coal)">${Math.round(T.ca/tot*100)}%</b>`:"No spend in this period";
  $("mix").innerHTML=tot?`<i style="width:${T.ga/tot*100}%;background:var(--gas);border-radius:6px 0 0 6px"></i><i style="flex:1;background:var(--coal);border-radius:0 6px 6px 0"></i>`:"";
  // sale %
  let sale=0,est=0,fuelWithSale=0;for(let i=a;i<=b;i++){const u=U(S.prop,i);if(u.sale){sale+=u.sale;fuelWithSale+=d.ga[i]+d.ca[i]}if(u.est)est+=u.est}
  if(sale){$("kPct").textContent=(fuelWithSale/sale*100).toFixed(1)+"%";$("kPctS").textContent=`${R(fuelWithSale)} fuel on ${R(sale)} sale`}
  else{$("kPct").textContent="–";$("kPctS").textContent="Add restaurant sale in the table below"}
  sparkline($("spGas"),d.ga.map((v,i)=>d.gc[i]?v/d.gc[i]:null).slice(0,S.last+1),"#8FB6FF");
  sparkline($("spCoal"),d.ca.map((v,i)=>d.ck[i]?v/d.ck[i]:null).slice(0,S.last+1),"#FFB27E");
  drawHeap(T.ck);
  insights();
  chartSpend();chartCyl();propList();chartKg();table();
}
function isPartial(i){const now=new Date();const m=MONTHS_STD[(now.getMonth()+9)%12];return S.months[i]==m}
function countUp(el,v,fmt){const from=+el.dataset.v||0;el.dataset.v=v;const t0=performance.now(),dur=700;
  (function f(t){const p=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-p,3);el.innerHTML=fmt(from+(v-from)*e);if(p<1)requestAnimationFrame(f)})(t0)}

function sparkline(svg,vals,col){
  const w=220,h=38;svg.setAttribute("viewBox",`0 0 ${w} ${h}`);
  const pts=vals.map((v,i)=>v==null?null:[i,v]).filter(Boolean);
  if(pts.length<2){svg.innerHTML="";return}
  const mx=Math.max(...pts.map(p=>p[1])),mn=Math.min(...pts.map(p=>p[1]));
  const X=i=>4+i*(w-8)/Math.max(1,vals.length-1),Y=v=>h-6-(mx==mn?.5:(v-mn)/(mx-mn))*(h-14);
  const path=pts.map((p,k)=>(k?"L":"M")+X(p[0]).toFixed(1)+" "+Y(p[1]).toFixed(1)).join(" ");
  const lp=pts[pts.length-1];
  svg.innerHTML=`<path d="${path}" fill="none" stroke="${col}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`+
  `<circle cx="${X(lp[0])}" cy="${Y(lp[1])}" r="4" fill="${col}" stroke="rgba(0,0,0,.4)" stroke-width="2"/>`+
  `<text x="${Math.min(X(lp[0])+8,w)}" y="${Y(lp[1])+4}" fill="#fff" font-size="11" font-weight="800">${R(lp[1])}</text>`+
  pts.map(p=>`<circle cx="${X(p[0])}" cy="${Y(p[1])}" r="9" fill="transparent" data-tip="${monthLabel(p[0])}|${R(p[1])}"/>`).join("");
  svg.querySelectorAll("[data-tip]").forEach(c=>{c.onmousemove=e=>{const [t,v]=c.dataset.tip.split("|");tip(e,`<div class="tt">${t}</div>${v}`)};c.onmouseleave=hideTip});
}
// coal heap art – lumps scale with quantity
function drawHeap(kg){
  const g=$("heapArt");if(!g)return;
  const n=Math.max(8,Math.min(34,Math.round(8+Math.log10(1+kg)*6)));
  let s="",seed=7;const rnd=()=>{seed=(seed*9301+49297)%233280;return seed/233280};
  const rocks=[];for(let i=0;i<n;i++){const u=rnd()*2-1;const hmax=(1-u*u)*(40+n*1.6);rocks.push({x:88+u*66,y:196-rnd()*hmax,r:7+rnd()*8})}
  rocks.sort((a,b)=>a.y-b.y);
  for(const r of rocks){const k=6;let p="";for(let j=0;j<k;j++){const a=j/k*Math.PI*2+rnd()*.5,rr=r.r*(.75+rnd()*.4);p+=(j?"L":"M")+(r.x+Math.cos(a)*rr).toFixed(1)+" "+(r.y+Math.sin(a)*rr*.8).toFixed(1)}
    s+=`<path d="${p}Z" fill="url(#rockG)" stroke="#000" stroke-opacity=".4"/>`;
    if(rnd()<.7)s+=`<path class="emb" d="${p}Z" fill="url(#emberG)" opacity=".8" style="mix-blend-mode:screen"/>`}
  g.innerHTML=s;
  let sp="";for(let i=0;i<9;i++){sp+=`<circle class="spk" cx="${40+rnd()*100}" cy="${150+rnd()*30}" r="${1+rnd()*1.6}" fill="#FFC27A" style="animation-delay:-${(rnd()*2.6).toFixed(2)}s;animation-duration:${(2+rnd()*1.4).toFixed(2)}s"/>`}
  $("sparkArt").innerHTML=sp;
}

/* insights */
function insights(){
  const d=D(),L=S.last,out=[];
  const done=isPartial(L)&&L>0?L-1:L; // last complete month
  let pk=0;for(let i=0;i<=L;i++)if(d.gc[i]>d.gc[pk])pk=i;
  if(d.gc[pk])out.push({k:"🔥 Busiest gas month",t:`<b>${monthLabel(pk)}</b> used <b>${N(d.gc[pk])} cylinders</b>${pk==done||pk==L?"":""} — ${d.gc[pk]&&d.ga[pk]?R(d.ga[pk])+" of gas":""}.`});
  if(done>0){const a=d.ga[done]+d.ca[done],b=d.ga[done-1]+d.ca[done-1];
    if(b){const ch=(a-b)/b*100;out.push({k:ch>0?"📈 Month on month":"📉 Month on month",t:`${monthLabel(done)} fuel spend was <b>${R(a)}</b>, <b style="color:${ch>0?"var(--bad)":"var(--good)"}">${ch>0?"+":""}${ch.toFixed(0)}%</b> vs ${S.months[done-1]}.`})}}
  if(S.prop=="ALL PROPERTIES"){
    const [a,b]=range();let best=null;
    for(const p of S.props){if(p=="ALL PROPERTIES")continue;const t=agg(S.data[p],a,b);const v=t.ga+t.ca;if(!best||v>best.v)best={p,v}}
    const all=agg(d,a,b);if(best&&best.v)out.push({k:"🏨 Top spender",t:`<b>${esc(short(best.p))}</b> — ${R(best.v)}, <b>${Math.round(best.v/(all.ga+all.ca)*100)}%</b> of all fuel spend.`});
  }else{
    let ck=0;for(let i=0;i<=L;i++)if(d.ck[i]>d.ck[ck])ck=i;
    if(d.ck[ck])out.push({k:"🪵 Most coal + wood",t:`<b>${monthLabel(ck)}</b>: <b>${N(d.ck[ck])} kg</b> for ${R(d.ca[ck])}.`});
  }
  // price check: ₹/cylinder outliers
  const flags=[];const props=S.prop=="ALL PROPERTIES"?S.props.filter(p=>p!="ALL PROPERTIES"):[S.prop];
  for(const p of props){const x=S.data[p];for(let i=0;i<=L;i++){if(x.gc[i]>0){const pc=x.ga[i]/x.gc[i];if(pc<600||pc>5000)flags.push(`${short(p)} ${S.months[i]} (${R(pc)}/cyl)`)}else if(x.ga[i]>0)flags.push(`${short(p)} ${S.months[i]} (₹ with 0 cyl)`)}}
  if(flags.length)out.push({w:1,k:"⚠️ Check these entries",t:`Unusual gas price per cylinder: <b>${esc(flags.slice(0,3).join(", "))}</b>${flags.length>3?` +${flags.length-3} more`:""}.`});
  else{const T=agg(d,0,L);out.push({k:"✅ Prices look normal",t:`Average <b>${T.gc?R(T.ga/T.gc):"–"}</b> per cylinder and <b>${T.ck?R(T.ca/T.ck):"–"}</b> per kg so far this year.`})}
  $("ins").innerHTML=out.slice(0,4).map(o=>`<div class="in${o.w?" warn":""}"><div class="k">${o.k}</div>${o.t}</div>`).join("");
}

/* ===================== CHARTS ===================== */
const tipEl=$("tip");
function tip(e,h){tipEl.innerHTML=h;tipEl.classList.add("on");const r=tipEl.getBoundingClientRect();let x=e.clientX+14,y=e.clientY-r.height-12;if(x+r.width>innerWidth-8)x=e.clientX-r.width-14;if(y<8)y=e.clientY+16;tipEl.style.left=x+"px";tipEl.style.top=y+"px"}
function hideTip(){tipEl.classList.remove("on")}
function niceMax(v){if(v<=0)return 1;const p=Math.pow(10,Math.floor(Math.log10(v)));const n=v/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p}
function frame(el,h){const W=Math.max(320,el.clientWidth||560);return{W,H:h,l:52,r:10,t:16,b:28}}
function axes(f,max,fmt){let s="";for(let k=0;k<=4;k++){const v=max*k/4,y=f.t+(f.H-f.t-f.b)*(1-k/4);s+=`<line class="gl" x1="${f.l}" x2="${f.W-f.r}" y1="${y}" y2="${y}"/><text class="ax" x="${f.l-8}" y="${y+4}" text-anchor="end">${fmt(v)}</text>`}return s}
const selI=()=>S.per=="ytd"?-1:+S.per;
function bindTips(el){el.querySelectorAll("[data-i]").forEach(h=>{
  h.onmousemove=e=>tip(e,h._tip());h.onmouseleave=hideTip;
  h.onclick=()=>{const i=+h.dataset.i;S.per=(S.per==String(i))?"ytd":String(i);$("perSel").value=S.per;saveView();render()}})}

function chartSpend(){
  const el=$("chSpend"),d=D(),n=S.last+1,f=frame(el,250);
  const max=niceMax(Math.max(...d.ga.slice(0,n),...d.ca.slice(0,n)));
  const pw=(f.W-f.l-f.r)/n,bw=Math.min(22,(pw-12)/2),H=f.H-f.t-f.b,y=v=>f.t+H*(1-v/max);
  let s=axes(f,max,RL);const si=selI();
  for(let i=0;i<n;i++){const cx=f.l+pw*(i+.5),dim=si>=0&&si!=i?' class="bar-dim"':"";
    const g=d.ga[i],c=d.ca[i];
    s+=`<g${dim}>${g?bar(cx-1-bw,y(g),bw,f.t+H-y(g),"var(--gas)"):""}${c?bar(cx+1,y(c),bw,f.t+H-y(c),"var(--coal)"):""}</g>`;
    s+=`<text class="ax" x="${cx}" y="${f.H-8}" text-anchor="middle">${S.months[i]}</text>`;
    s+=`<rect class="hit" data-i="${i}" x="${cx-pw/2}" y="${f.t}" width="${pw}" height="${H}"/>`}
  // direct label on max total
  let mi=0;for(let i=0;i<n;i++)if(d.ga[i]+d.ca[i]>d.ga[mi]+d.ca[mi])mi=i;
  if(d.ga[mi]+d.ca[mi]){const cx=f.l+pw*(mi+.5);s+=`<text x="${cx}" y="${y(Math.max(d.ga[mi],d.ca[mi]))-7}" text-anchor="middle" font-size="11" font-weight="800" fill="var(--ink)">${RL(d.ga[mi]+d.ca[mi])}</text>`}
  el.innerHTML=`<svg viewBox="0 0 ${f.W} ${f.H}" height="${f.H}">${s}</svg>`;
  el.querySelectorAll("[data-i]").forEach(h=>{const i=+h.dataset.i;h._tip=()=>`<div class="tt">${monthLabel(i)}</div><div class="tr"><span><i style="background:var(--gas)"></i>Gas</span><b>${R(d.ga[i])}</b></div><div class="tr"><span><i style="background:var(--coal)"></i>Coal + wood</span><b>${R(d.ca[i])}</b></div><div class="tr mut"><span>Total</span><b>${R(d.ga[i]+d.ca[i])}</b></div>`});
  bindTips(el);
}
function bar(x,y,w,h,col){if(h<=0)return"";const r=Math.min(4,h,w/2);return `<path d="M${x} ${y+h}V${y+r}Q${x} ${y} ${x+r} ${y}H${x+w-r}Q${x+w} ${y} ${x+w} ${y+r}V${y+h}Z" fill="${col}"/>`}

function chartCyl(){
  const el=$("chCyl"),d=D(),n=S.last+1,f=frame(el,250);f.l=40;
  const max=niceMax(Math.max(...d.gc.slice(0,n))*1.1);const pw=(f.W-f.l-f.r)/n,bw=Math.min(34,pw*.5),H=f.H-f.t-f.b,y=v=>f.t+H*(1-v/max);
  let s=`<defs><linearGradient id="cylB" x1="0" x2="1"><stop offset="0" stop-color="#1F55BD"/><stop offset=".4" stop-color="#2F6FE4"/><stop offset=".6" stop-color="#5A8FF0"/><stop offset="1" stop-color="#1F55BD"/></linearGradient></defs>`;
  s+=axes(f,max,v=>N(v));const si=selI();
  const nz=d.gc.slice(0,n).filter(v=>v>0),avg=nz.length?sum(nz)/nz.length:0;
  let mx=0;for(let i=0;i<n;i++)if(d.gc[i]>d.gc[mx])mx=i;
  for(let i=0;i<n;i++){const v=d.gc[i],cx=f.l+pw*(i+.5),x=cx-bw/2,top=y(v),h=f.t+H-top;
    if(v>0){const dome=Math.min(bw*.42,h*.5);
      s+=`<g${si>=0&&si!=i?' class="bar-dim"':""}><path d="M${x} ${f.t+H}V${top+dome}Q${x} ${top} ${cx} ${top}Q${x+bw} ${top} ${x+bw} ${top+dome}V${f.t+H}Z" fill="url(#cylB)"/>`+
      (h>26?`<rect x="${x}" y="${top+dome+Math.min(10,h*.2)}" width="${bw}" height="${Math.min(5,h*.08)}" fill="#fff" opacity=".35"/>`:"")+
      `<rect x="${cx-bw*.16}" y="${top-5}" width="${bw*.32}" height="5" rx="1.5" fill="#C9A43A"/></g>`}
    if(i==mx||i==si)s+=`<text x="${cx}" y="${top-10}" text-anchor="middle" font-size="11" font-weight="800" fill="var(--ink)">${N(v)}</text>`;
    s+=`<text class="ax" x="${cx}" y="${f.H-8}" text-anchor="middle">${S.months[i]}</text><rect class="hit" data-i="${i}" x="${cx-pw/2}" y="${f.t}" width="${pw}" height="${H}"/>`}
  if(avg){s+=`<line x1="${f.l}" x2="${f.W-f.r}" y1="${y(avg)}" y2="${y(avg)}" stroke="var(--ink2)" stroke-dasharray="4 4" stroke-width="1.2" opacity=".6"/><text x="${f.W-f.r}" y="${y(avg)-6}" text-anchor="end" font-size="10.5" font-weight="700" fill="var(--ink2)">avg ${N(avg)}</text>`}
  el.innerHTML=`<svg viewBox="0 0 ${f.W} ${f.H}" height="${f.H}">${s}</svg>`;
  el.querySelectorAll("[data-i]").forEach(h=>{const i=+h.dataset.i;h._tip=()=>`<div class="tt">${monthLabel(i)}</div><div class="tr"><span>Cylinders</span><b>${N(d.gc[i])}</b></div><div class="tr"><span>Gas spend</span><b>${R(d.ga[i])}</b></div><div class="tr mut"><span>Per cylinder</span><b>${d.gc[i]?R(d.ga[i]/d.gc[i]):"–"}</b></div>`});
  bindTips(el);
}
function chartKg(){
  const el=$("chKg"),d=D(),n=S.last+1,f=frame(el,Math.max(230,($("plist").offsetHeight||300)-10));f.l=46;
  const max=niceMax(Math.max(...d.ck.slice(0,n))*1.08);const pw=(f.W-f.l-f.r)/n,bw=Math.min(34,pw*.5),H=f.H-f.t-f.b,y=v=>f.t+H*(1-v/max);
  let s=`<defs><linearGradient id="coalB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F08A4B"/><stop offset=".25" stop-color="#E0662A"/><stop offset="1" stop-color="#B84A17"/></linearGradient></defs>`;
  s+=axes(f,max,v=>v>=1000?(+(v/1000).toFixed(1))+"k":N(v));const si=selI();
