    s+=`<text class="ax" x="${cx}" y="${f.H-8}" text-anchor="middle">${S.months[i]}</text><rect class="hit" data-i="${i}" x="${cx-pw/2}" y="${f.t}" width="${pw}" height="${H}"/>`}
