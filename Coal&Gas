    raf=requestAnimationFrame(frameFn);
  }
  function finish(){if(ended)return;ended=true;running=false;cancelAnimationFrame(raf);intro.classList.add("out");setTimeout(()=>{intro.style.display="none"},950)}
  function play(){
    intro.style.display="";intro.className="";ended=false;running=true;t0=0;last=0;W=0;smoke=[];sparks=[];burst=[];burstDone=false;
    lw.style.opacity=0;
    if(matchMedia("(prefers-reduced-motion: reduce)").matches){setTimeout(finish,300);return}
    raf=requestAnimationFrame(frameFn);
    setTimeout(()=>{if(!ended)finish()},T_END+4000); // safety net
  }
  addEventListener("resize",()=>{if(running)size()});
  $("skip").onclick=finish;
  $("replay").onclick=()=>{window.scrollTo(0,0);play()};
  play();
})();

load();
</script>
