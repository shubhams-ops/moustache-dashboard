</div>

<div class="shell">
  <aside class="side">
    <div class="brand"><div class="logo"><svg viewBox="0 0 140 140" aria-hidden="true"><defs><radialGradient id="shG2" cx=".5" cy=".35" r=".75"><stop offset="0" stop-color="#4FD37A"/><stop offset=".6" stop-color="#22A04F"/><stop offset="1" stop-color="#157A3A"/></radialGradient></defs><path d="M70 70 C 72 92, 80 112, 96 128" fill="none" stroke="#0B1A12" stroke-width="9" stroke-linecap="round"/><path d="M70 70 C 72 92, 80 112, 96 128" fill="none" stroke="#22A04F" stroke-width="4" stroke-linecap="round"/><g transform="rotate(0 70 66)"><path d="M70 66 C 54 56, 36 40, 46 24 C 54 12, 68 18, 70 30 C 72 18, 86 12, 94 24 C 104 40, 86 56, 70 66 Z" fill="url(#shG2)" stroke="#0B1A12" stroke-width="3.5" stroke-linejoin="round"/><path d="M70 62 L70 34" stroke="#B8F0CF" stroke-width="2.4" stroke-linecap="round" opacity=".9"/></g><g transform="rotate(118 70 66)"><path d="M70 66 C 54 56, 36 40, 46 24 C 54 12, 68 18, 70 30 C 72 18, 86 12, 94 24 C 104 40, 86 56, 70 66 Z" fill="url(#shG2)" stroke="#0B1A12" stroke-width="3.5" stroke-linejoin="round"/><path d="M70 62 L70 34" stroke="#B8F0CF" stroke-width="2.4" stroke-linecap="round" opacity=".9"/></g><g transform="rotate(-118 70 66)"><path d="M70 66 C 54 56, 36 40, 46 24 C 54 12, 68 18, 70 30 C 72 18, 86 12, 94 24 C 104 40, 86 56, 70 66 Z" fill="url(#shG2)" stroke="#0B1A12" stroke-width="3.5" stroke-linejoin="round"/><path d="M70 62 L70 34" stroke="#B8F0CF" stroke-width="2.4" stroke-linecap="round" opacity=".9"/></g><circle cx="70" cy="66" r="4" fill="#157A3A" stroke="#0B1A12" stroke-width="2"/></svg></div><div><div class="bt">Personal Management System</div><div class="bs">Moustache F&amp;B</div></div></div>
